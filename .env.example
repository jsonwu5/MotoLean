# 复制为 .env.local 后填写；.env.local 已在 .gitignore 中，不会进版本库。
# 任何机器 / 智能体只要这份文件一致，打出来的就是同一个 App。

# 腾讯地图 iOS Key（必填），在 https://lbs.qq.com 创建，需绑定 Bundle ID com.jsonwoo.motolean
TENCENT_MAP_IOS_KEY=

# 腾讯地图 Android Key（可选，构建 Android 时需要）
# TENCENT_MAP_ANDROID_KEY=

# Apple 开发团队 ID（必填），Xcode 账号页可见，例如 LTXXXXXXXX
DEVELOPMENT_TEAM=

# 构建时需要代理时填写，例如 http://127.0.0.1:7890
# HTTP_PROXY=

# 安装目标设备（可选，填了脚本会自动安装），用 xcrun devicectl list devices 查看
# DEVICE_ID=
# 安装后是否自动启动
# LAUNCH=false
